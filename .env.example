# Secrets
ANTHROPIC_API_KEY=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=

# Docker networking (required for Docker Compose — app reaches WAHA by service name)
WAHA_API_URL=http://waha:3000

# Deployment-specific (not secret, but varies per setup)
BOT_PHONE_NUMBER=             # bot's WhatsApp number (for detecting replies to bot messages)
ADMIN_CHAT_ID=                # WhatsApp chat ID for admin alerts (unrecognized groups, errors)

# GitHub webhook — auto-pull course updates on push
GITHUB_WEBHOOK_SECRET=            # HMAC secret for verifying GitHub webhook signatures
GITHUB_COURSES_REPO=              # e.g., youruser/lapibot-courses

# Deploy — only needed on your local machine (used by scripts/deploy.sh)
# VPS_HOST=user@your-vps-ip
# VPS_PROJECT_DIR=/opt/lapibot-course-assistant
# VPS_COURSES_DIR=/opt/lapibot-courses
